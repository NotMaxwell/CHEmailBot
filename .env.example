# Copy to .env and fill in. Loaded from the project root no matter where the
# server is started from.

# --- Server ----------------------------------------------------------------
# Loopback only. A deployment that other machines must reach sets 0.0.0.0 and
# relies on the network around it -- see deploy/pi/README.md.
HOST=127.0.0.1
PORT=3000
# Relative paths resolve against the project root, never the working directory.
# An absolute path is how a deployment points this at a mounted disk.
DB_PATH=data/chembot.db

# Shared code required to create an account. Blank = anyone who can reach the
# app can sign themselves up, which is the intended model on the loopback bind
# and on a home LAN. Set it before the app is reachable from the internet.
SIGNUP_CODE=

# --- Sending guardrails ----------------------------------------------------
# 1 = render and log without transmitting. Leave on until you have sent one
# real message to yourself and read what arrived.
DRY_RUN=1
# Warm-up ramp: daily caps by sending day, comma-separated.
SEND_RAMP=5,10,15,20,30,40,50
# Seconds between sends, randomized +/-40%.
SEND_INTERVAL_SECONDS=180

# --- Sender identity (required in every message; sending refuses without) --
# Appended to every outbound body as the footer.
SENDER_NAME=
# Appended to whoever signs, as "<name>, <org>". Leave blank for the name alone.
SENDER_ORG=
SENDER_POSTAL_ADDRESS=

# --- Gmail (OAuth "Web application" client; Google Auth Platform > Clients) -
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must match a redirect URI on the OAuth client character for character.
# Google will not accept a private IP over plain http, so a LAN deployment does
# the one-time authorisation through an SSH tunnel and leaves this as-is.
# On Render this is derived from RENDER_EXTERNAL_URL and can stay unset.
GMAIL_REDIRECT_URI=http://localhost:3000/oauth/callback
GMAIL_SENDER=you@example.com
# Where the refresh token is kept. Beside the database by default.
# GMAIL_TOKEN_PATH=data/.gmail-token.json
# Recipient for `bun run test:self` -- your own address, on a DIFFERENT
# provider than GMAIL_SENDER. Same-domain mail routes internally and never
# exercises SPF/DKIM/DMARC or spam filtering.
TEST_EMAIL=

# --- Scraper politeness ----------------------------------------------------
SCRAPE_DELAY_MS=2000
SCRAPE_TIMEOUT_MS=30000
# Defaults to CHEmailBot/<version>. This header is sent to every site crawled,
# so only put contact details here that you are comfortable publishing.
# SCRAPE_USER_AGENT=
