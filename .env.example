# --- Gmail (OAuth desktop-app client from console.cloud.google.com) ---------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth/callback
GMAIL_SENDER=william.max.mccormick@gmail.com

# --- Sending guardrails ----------------------------------------------------
# Warm-up ramp: daily caps, comma-separated. Queue stops at the day's cap.
SEND_RAMP=5,10,15,20,30,40,50
# Seconds between sends, randomized +/-40% so it doesn't look robotic.
SEND_INTERVAL_SECONDS=180
# Set to 1 to render + log without transmitting. START HERE.
DRY_RUN=1

# --- CAN-SPAM (legally required in every message) --------------------------
SENDER_NAME=
SENDER_POSTAL_ADDRESS=
UNSUBSCRIBE_MAILTO=

# --- Scraper politeness ----------------------------------------------------
SCRAPE_DELAY_MS=2000
SCRAPE_USER_AGENT=CHEmailBot/0.1 (+contact: william.max.mccormick@gmail.com)

PORT=3000
DB_PATH=data/chembot.db
